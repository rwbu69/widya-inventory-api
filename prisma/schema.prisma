generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
}

model Item {
    id          Int      @id @default(autoincrement())
    name        String
    description String?
    stock       Int?
    price       Int
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
